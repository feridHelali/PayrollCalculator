<Application x:Class="PayrollCalculator.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PayrollCalculator.Wpf.ViewModels"
             xmlns:v="clr-namespace:PayrollCalculator.Wpf.Views"
             xmlns:conv="clr-namespace:PayrollCalculator.Wpf.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette -->
            <SolidColorBrush x:Key="Brush.Accent" Color="#1F5C99" />
            <SolidColorBrush x:Key="Brush.AccentLight" Color="#E6EEF7" />
            <SolidColorBrush x:Key="Brush.Nav" Color="#17324D" />
            <SolidColorBrush x:Key="Brush.Border" Color="#D0D7DE" />
            <SolidColorBrush x:Key="Brush.Warning" Color="#B54708" />

            <conv:SalaryTypeTextConverter x:Key="SalaryTypeText" />
            <conv:IssueTextConverter x:Key="IssueText" />
            <conv:DateOnlyTextConverter x:Key="DateText" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <Style TargetType="TextBlock" x:Key="PageTitle">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="Padding" Value="0,6,0,2" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="4" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="4" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinWidth" Value="80" />
            </Style>
            <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
            </Style>
            <Style TargetType="Button" x:Key="NavButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Setter Property="AlternatingRowBackground" Value="#F7F9FB" />
                <Setter Property="RowHeaderWidth" Value="0" />
            </Style>
            <Style TargetType="StackPanel" x:Key="Toolbar">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <!-- Page view model -> view mapping -->
            <DataTemplate DataType="{x:Type vm:AgreementsViewModel}"><v:AgreementsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalaryTablesViewModel}"><v:SalaryTablesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SalaryTableEditorViewModel}"><v:SalaryTableEditorView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AffairsViewModel}"><v:AffairsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AffairEditorViewModel}"><v:AffairEditorView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TimelineViewModel}"><v:TimelineView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
