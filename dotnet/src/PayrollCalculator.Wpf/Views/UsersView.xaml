<UserControl x:Class="PayrollCalculator.Wpf.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PayrollCalculator.Wpf.ViewModels"
             xmlns:res="clr-namespace:PayrollCalculator.Wpf.Resources"
             xmlns:c="clr-namespace:PayrollCalculator.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UsersViewModel}">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{Binding Title}" />

        <Border DockPanel.Dock="Left" Width="380" Margin="0,0,20,0" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static c:Icons.AddUser}" Foreground="{StaticResource Brush.Accent}" Margin="0,0,8,8" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Labels.AddUser}" />
                </StackPanel>
                <Label Content="{x:Static res:Labels.UserName}" />
                <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" />
                <Label Content="{x:Static res:Labels.DisplayName}" />
                <TextBox Text="{Binding NewDisplayName, UpdateSourceTrigger=PropertyChanged}" />

                <Label Content="{x:Static res:Labels.TemporaryPassword}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="8,0,0,4" MinWidth="0" c:Ui.Icon="{x:Static c:Icons.Generate}"
                            Content="{x:Static res:Labels.Generate}" Command="{Binding GeneratePasswordCommand}" />
                    <TextBox Text="{Binding TempPassword, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                             FontFamily="Consolas" FontSize="15" />
                </DockPanel>
                <TextBlock Style="{StaticResource Muted}" Text="{x:Static res:Labels.TemporaryPasswordHint}" Margin="0,2,0,0" />
                <TextBlock Style="{StaticResource Muted}" Text="{x:Static res:Labels.PasswordRules}" Margin="0,2,0,0" />

                <StackPanel Style="{StaticResource Toolbar}" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" c:Ui.Icon="{x:Static c:Icons.AddUser}"
                            Content="{x:Static res:Labels.AddUser}" Command="{Binding AddCommand}" />
                    <Button c:Ui.Icon="{x:Static c:Icons.ResetPassword}"
                            Content="{x:Static res:Labels.ResetPassword}" Command="{Binding ResetPasswordCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:Labels.UserName}" Binding="{Binding UserName}" Width="*" />
                <DataGridTextColumn Header="{x:Static res:Labels.DisplayName}" Binding="{Binding DisplayName}" Width="1.5*" />
                <DataGridTextColumn Header="{x:Static res:Labels.Status}" Binding="{Binding Status, Converter={StaticResource UserStatusText}}" Width="1.5*" />
                <DataGridTextColumn Header="{x:Static res:Labels.LastSignIn}" Binding="{Binding LastSignedInOn, Converter={StaticResource LocalDateTimeText}}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
