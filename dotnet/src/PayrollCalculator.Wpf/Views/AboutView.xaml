<UserControl x:Class="PayrollCalculator.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PayrollCalculator.Wpf.ViewModels"
             xmlns:res="clr-namespace:PayrollCalculator.Wpf.Resources"
             xmlns:c="clr-namespace:PayrollCalculator.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="Key" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,16,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Value">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />

            <!-- Identity -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="12,0,0,12" Background="{StaticResource Brush.BrandGradient}">
                        <Border Background="White" CornerRadius="16" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="{StaticResource Logo}" Width="64" Height="60" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="24,20">
                        <TextBlock Text="{Binding Product.Name}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" FontSize="13" Text="{x:Static res:Labels.AppDescription}" Margin="0,2,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource Brush.AccentLight}" CornerRadius="10" Padding="10,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static res:Labels.Version}" Foreground="{StaticResource Brush.Accent}" FontSize="12" />
                                    <TextBlock Text="{Binding Product.Version}" Foreground="{StaticResource Brush.Accent}" FontWeight="SemiBold"
                                               FontSize="12" Margin="6,0,0,0" FlowDirection="LeftToRight" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Muted}" Text="{Binding Product.Copyright}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" FlowDirection="LeftToRight" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Credits -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Key}" Text="{x:Static res:Labels.Idea}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Value}" FontWeight="SemiBold" Text="{x:Static res:Labels.IdeaBy}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="{x:Static res:Labels.Development}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{x:Static res:Labels.DevelopedBy}" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Muted}" Margin="0,6,0,0"
                               Text="{x:Static res:Labels.AssistedBy}" />
                </Grid>
            </Border>

            <!-- Support -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static res:Labels.SupportInfo}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Key}" Text="{x:Static res:Labels.Version}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Product.DisplayVersion}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Key}" Text="{x:Static res:Labels.Runtime}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding Runtime}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="2" Style="{StaticResource Key}" Text="{x:Static res:Labels.OperatingSystem}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding OperatingSystem}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="3" Style="{StaticResource Key}" Text="{x:Static res:Labels.Database}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding DatabasePath}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Muted}" Text="{Binding DataNote}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Style="{StaticResource Key}" Text="{x:Static res:Labels.License}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding LicenseText}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                    </Grid>
                    <StackPanel Style="{StaticResource Toolbar}" Margin="0,14,0,0">
                        <Button c:Ui.Icon="{x:Static c:Icons.Copy}" Content="{x:Static res:Labels.CopyInfo}" Click="OnCopyInfo" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
