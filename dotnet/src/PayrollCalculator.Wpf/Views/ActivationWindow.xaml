<Window x:Class="PayrollCalculator.Wpf.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PayrollCalculator.Wpf.ViewModels"
        xmlns:res="clr-namespace:PayrollCalculator.Wpf.Resources"
        xmlns:c="clr-namespace:PayrollCalculator.Wpf.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ActivationViewModel}"
        Title="{x:Static res:Labels.AppTitle}" Icon="{StaticResource Logo}"
        Width="600" Height="380" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft" Language="ar-TN" FontFamily="Segoe UI" FontSize="14"
        Foreground="{StaticResource Brush.Text}" MouseLeftButtonDown="OnDrag">
    <Border CornerRadius="14" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.25" />
        </Border.Effect>
        <Grid Margin="36,28,36,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{x:Static res:Labels.Activation}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{x:Static res:Labels.ActivationPrompt}" />
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,22,0,12">
                <Label Content="{x:Static res:Labels.SerialNumber}" />
                <TextBox x:Name="SerialBox" Text="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"
                         FontFamily="Consolas" FontSize="16" CharacterCasing="Upper" MaxLength="40" KeyDown="OnSerialKeyDown" />
                <TextBlock Style="{StaticResource Muted}" Text="XXXXX-XXXXX-XXXXX-XXXXX" FlowDirection="LeftToRight"
                           HorizontalAlignment="Right" FontFamily="Consolas" Margin="0,4,0,0" />
                <Border Margin="0,12,0,0" Padding="10,7" CornerRadius="8" Background="{StaticResource Brush.DangerLight}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Danger}" FontSize="12.5" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <DockPanel Grid.Row="2" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" MinWidth="130"
                        c:Ui.Icon="{x:Static c:Icons.ResetPassword}" Content="{x:Static res:Labels.Activate}" Click="OnActivate" />
                <Button DockPanel.Dock="Right" Margin="0" c:Ui.Icon="{x:Static c:Icons.Close}"
                        Content="{x:Static res:Labels.Quit}" IsCancel="True" Click="OnQuit" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
