<UserControl x:Class="PayrollCalculator.Wpf.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PayrollCalculator.Wpf.ViewModels"
             xmlns:res="clr-namespace:PayrollCalculator.Wpf.Resources"
             xmlns:c="clr-namespace:PayrollCalculator.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChangePasswordViewModel}">
    <StackPanel HorizontalAlignment="Left" Width="440">
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource Glyph}" Text="{x:Static c:Icons.User}" Foreground="{StaticResource Brush.Accent}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FlowDirection="LeftToRight" />
                </StackPanel>
                <Label Content="{x:Static res:Labels.MyCurrentPassword}" />
                <PasswordBox x:Name="CurrentPasswordBox" FlowDirection="LeftToRight" />
                <Label Content="{x:Static res:Labels.NewPassword}" />
                <PasswordBox x:Name="NewPasswordBox" FlowDirection="LeftToRight" />
                <Label Content="{x:Static res:Labels.ConfirmPassword}" />
                <PasswordBox x:Name="ConfirmPasswordBox" FlowDirection="LeftToRight" />
                <TextBlock Style="{StaticResource Muted}" Text="{x:Static res:Labels.PasswordRules}" Margin="0,4,0,0" />

                <Border Margin="0,12,0,0" Padding="10,7" CornerRadius="8" Background="{StaticResource Brush.DangerLight}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Danger}" FontSize="12.5" TextWrapping="Wrap" />
                </Border>

                <StackPanel Style="{StaticResource Toolbar}" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" c:Ui.Icon="{x:Static c:Icons.Password}"
                            Content="{x:Static res:Labels.ChangeMyPassword}" Click="OnChange" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
