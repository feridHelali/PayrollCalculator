<Window x:Class="PayrollCalculator.Wpf.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:PayrollCalculator.Wpf.Resources"
        Title="{x:Static res:Labels.AppTitle}" Icon="{StaticResource Logo}"
        Width="560" Height="340" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True"
        FlowDirection="RightToLeft" Language="ar-TN" FontFamily="Segoe UI">
    <Border CornerRadius="16" Background="{StaticResource Brush.BrandGradient}" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.3" />
        </Border.Effect>
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Background="White" CornerRadius="18" Padding="14" Width="104" Height="104">
                    <Image Source="{StaticResource Logo}" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Labels.AppTitle}" Foreground="White" FontSize="34" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static res:Labels.AppDescription}" Foreground="White" Opacity="0.9" FontSize="13"
                               TextWrapping="Wrap" MaxWidth="280" Margin="0,2,0,8" />
                    <TextBlock x:Name="VersionText" Foreground="White" Opacity="0.85" FontSize="12" FlowDirection="LeftToRight"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" x:Name="StageText" Foreground="White" FontSize="12.5" />
                    <TextBlock Text="{x:Static res:Labels.Publisher}" Foreground="White" Opacity="0.75" FontSize="11"
                               HorizontalAlignment="Right" FlowDirection="LeftToRight" />
                </DockPanel>
                <Border x:Name="ProgressTrack" Height="4" CornerRadius="2" Background="#40FFFFFF" Margin="0,8,0,0">
                    <Border x:Name="ProgressFill" CornerRadius="2" Background="White" HorizontalAlignment="Left" Width="0" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
