<UserControl x:Class="PayrollCalculator.Wpf.Views.AgreementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PayrollCalculator.Wpf.ViewModels"
             xmlns:res="clr-namespace:PayrollCalculator.Wpf.Resources"
             xmlns:c="clr-namespace:PayrollCalculator.Wpf.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AgreementsViewModel}">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="{Binding Title}" />
        <Border DockPanel.Dock="Left" Width="360" Margin="0,0,20,0" Padding="16"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <Label Content="{x:Static res:Labels.AgreementName}" />
                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                <Label Content="{x:Static res:Labels.Description}" />
                <TextBox Text="{Binding EditDescription}" Height="120" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
                <StackPanel Style="{StaticResource Toolbar}" Margin="0,12,0,0">
                    <Button Style="{StaticResource PrimaryButton}" c:Ui.Icon="{x:Static c:Icons.Save}" Content="{x:Static res:Labels.Save}" Command="{Binding SaveCommand}" />
                    <Button c:Ui.Icon="{x:Static c:Icons.New}" Content="{x:Static res:Labels.New}" Command="{Binding NewCommand}" />
                    <Button Style="{StaticResource DangerButton}" c:Ui.Icon="{x:Static c:Icons.Delete}" Content="{x:Static res:Labels.Delete}" Command="{Binding DeleteCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <DataGrid ItemsSource="{Binding Agreements}" SelectedItem="{Binding SelectedAgreement}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static res:Labels.AgreementName}" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="{x:Static res:Labels.Description}" Binding="{Binding Description}" Width="*" />
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowDeleteButton}"
                                    Visibility="{Binding IsSeeded, Converter={StaticResource InverseBoolToVisibility}}"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
